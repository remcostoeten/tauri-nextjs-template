# Database Configuration
DATABASE_URL="python3 scripts/generate-turso-db.py"
DATABASE_AUTH_TOKEN=python3 scripts/generate-turso-db.py

JWT_SECRET="your_secure_jwt_secret_min_32_characters_long"
ADMIN_EMAIL="admin@yourdomain.com"

# Node Environment (development or production)
NODE_ENV="development"

# OAuth Configurationv
# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Discord OAuth
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Skip environment validation in development
# SKIP_ENV_VALIDATION="true"